// website/, served at https://idct.tech/chromis/ by a Cloudflare Worker that is nothing but
// static assets. Deployed by .github/workflows/pages.yml and never any other way - not by hand,
// and not by Cloudflare's own Git integration, which would deploy whether or not the workflow's
// checks passed.
{
  "name": "chromis-site",
  "compatibility_date": "2026-09-22",

  // Routes, not a custom domain. The site is a path on idct.tech, and the root of that domain
  // belongs to the org's apex site (repo: ideaconnect.github.io). A custom domain would claim
  // the whole hostname; these claim /chromis and everything under it, and every other path on
  // idct.tech carries on through to GitHub untouched.
  "routes": [
    { "pattern": "idct.tech/chromis", "zone_name": "idct.tech" },
    { "pattern": "idct.tech/chromis/*", "zone_name": "idct.tech" }
  ],

  // No second copy of the site on a workers.dev address for anyone to find and link to.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    // The workflow copies website/ to dist/chromis/: the route keeps the /chromis/ prefix on
    // every request, and every link in the site is relative to it. website/_redirects is moved
    // up to dist/_redirects, the only place Cloudflare reads it from.
    "directory": "./dist",
    // "none", not the default, and the pages' URLs are the reason. The default rewrites every
    // .html URL: /chromis/privacy.html answers 307 to /chromis/privacy. That is the address the
    // app's About screen and the Play listing's privacy-policy field hold, and the canonical and
    // sitemap entry of the page itself - a policy URL that redirects, and a sitemap full of
    // redirects. "none" serves a file at exactly its own path, and _redirects supplies the two
    // things it will not do on its own: /chromis/ -> index.html, and the extensionless
    // spellings GitHub Pages used to answer.
    "html_handling": "none",
    // No 404.html in the site, so a missing URL gets a bare 404.
    "not_found_handling": "none"
  }
}
